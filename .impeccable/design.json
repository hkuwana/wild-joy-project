  "narrative": {
    "northStar": "Photographic travel correspondence",
    "overview": "This records the implemented photographic travel-correspondence direction: expressive serif headings, warm paper surfaces, personal invitations, and generous space around source photography. The photos carry the identity; navigation and practical retreat information use familiar web patterns.\n\nThis is a reversible first-draft implementation record, not a newly approved brand identity. PRODUCT.md remains the product authority; docs/first-draft-brief.md owns the page strategy. Values were extracted from site/styles.css, site/fonts.css, and scripts/build.mjs on November 4, 2026. This documentation pass did not inspect rendered pages or establish new brand commitments.\n\nSidecar tonal ramps are synthesized OKLCH panel previews, not additional implemented CSS tokens or approved palette choices. Component snippets retain CSS variable references with extracted fallback values. Text is illustrative where a snippet requires sample content.",
    "keyCharacteristics": [
      "Photo-led compositions with restrained colored section backgrounds.",
      "Fraunces headings paired with readable DM Sans body text.",
      "Mostly flat rectangular surfaces, fine dividing rules, and one lightly lifted invitation tag.",
      "Conventional navigation, native disclosure controls, and contextual keyboard focus."
    ],
    "rules": [
      {
        "name": "The Contextual Focus Rule",
        "body": "Use a rust outline on the light surfaces and a paper outline inside the rust closing section; retain the 3px outline and 6px offset.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the existing source photography and its rights attribution.",
      "Do preserve readable body copy, visible focus, native controls, and reduced-motion behavior.",
      "Do carry all three responsive thresholds forward when changing components.",
      "Do label this as a first-draft system until Alyssa reviews it."
    ],
    "donts": [
      "Don't treat the MIT implementation license as permission to relicense the photos or source text.",
      "Don't add booking, payment, newsletter, or availability states that have no implementation or verified source.",
      "Don't replace contextual focus outlines with a single color that disappears on the rust closing section.",
      "Don't turn these observed choices into permanent brand commitments without review."
    ]
  }
}
