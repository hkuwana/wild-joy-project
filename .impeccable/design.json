      "html": "<a class=\"ds-button ds-icon\" href=\"#example\">Explore rooms &amp; prices<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></a>",
